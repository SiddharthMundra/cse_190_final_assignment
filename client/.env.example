# Firebase (Web app config — Firebase console → Project settings → Your apps)
# Spark (free) tier is sufficient. Enable Google sign-in under Authentication.
# Deploy firestore.rules from the repo root: firebase deploy --only firestore:rules
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
